# Nothing to set for the Edge Functions: Supabase provides SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY to them automatically. Never put the service role key
# in any frontend .env file.

# Optional emails from the contact function (set with: npx supabase secrets set NAME=value).
# Without RESEND_API_KEY nothing is emailed; messages are still stored in contact_messages.
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=you@example.com          # new questions and access requests go here
# MAIL_FROM="Splitcraft <hello@your-domain.com>"  # a domain verified in Resend; enables auto-replies
