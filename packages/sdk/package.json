{
  "name": "@splitcraft/sdk",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/splitcraft.js",
  "module": "./dist/splitcraft.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/splitcraft.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && vite build -c vite.qa.config.ts && vite build -c vite.metrics.config.ts && vite build -c vite.react.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "description": "Splitcraft A/B testing SDK: script tag or npm, with a React hook.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhriti-kumawat/splitcraft.git",
    "directory": "packages/sdk"
  },
  "sideEffects": [
    "./dist/splitcraft.js"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
